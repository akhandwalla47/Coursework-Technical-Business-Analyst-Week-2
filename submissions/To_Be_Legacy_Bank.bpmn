  <bpmn:collaboration id="Collaboration_0tqndz1">
    <bpmn:participant id="Participant_1tt1gqm" name="To-Be-Map Legacy Bank" processRef="Process_0aqis1c" />
    <bpmn:textAnnotation id="TextAnnotation_0q4ctw8">
      <bpmn:text>Portal handles customer identity checks, reducing the need
for this to be done manually.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12uwgg6">
      <bpmn:text>Removes the need for initial cross checks with emails and databases, saving reps time and effort</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1l16865">
      <bpmn:text>Customer can clearly see all of their options without a rep having to read them over the phone.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1eegp07">
      <bpmn:text>Rep only receives the cases that need to be dealt with by a human, solving the entanglement of straightforward and complex cases, and
allowing the reps to focus on the
customers that need more attention.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_06tuils">
      <bpmn:text>Removes the step of a rep idly waiting for a customer to respond</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1tmgkd1">
      <bpmn:text>Directly targets the pain point of reps forgetting to follow up/ make a note if they have</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0vwccgl" associationDirection="None" sourceRef="Activity_11jxqo9" targetRef="TextAnnotation_1eegp07" />
    <bpmn:association id="Association_15xef69" associationDirection="None" sourceRef="Activity_0f6i25a" targetRef="TextAnnotation_0q4ctw8" />
    <bpmn:association id="Association_109m0g3" associationDirection="None" sourceRef="Activity_0j99x8b" targetRef="TextAnnotation_1tmgkd1" />
    <bpmn:association id="Association_1519c38" associationDirection="None" sourceRef="Activity_04t0goj" targetRef="TextAnnotation_1l16865" />
  </bpmn:collaboration>
